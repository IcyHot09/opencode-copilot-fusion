{
  "name": "opencode-copilot-fusion",
  "version": "0.2.1",
  "description": "Use GitHub Copilot Fusion in opencode: /auto routing with session-anchored stickiness, Fusion tiers via reasoning-effort variants, reusing opencode's stored Copilot OAuth.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IcyHot09/opencode-copilot-fusion.git"
  },
  "homepage": "https://github.com/IcyHot09/opencode-copilot-fusion#readme",
  "bugs": {
    "url": "https://github.com/IcyHot09/opencode-copilot-fusion/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "github-copilot",
    "copilot-fusion",
    "plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
